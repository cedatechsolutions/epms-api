# Copy to .env alongside docker-compose.yml on the EC2 instance and fill in real values:
#   cp .env.example .env && chmod 600 .env && nano .env
#
# This file is read by docker compose (and by backup.sh). It holds production secrets, so the
# real .env must never be committed — deploy/.gitignore excludes it.

# --- Database -----------------------------------------------------------------
POSTGRES_DB=cems
POSTGRES_USER=cems
# openssl rand -base64 32
POSTGRES_PASSWORD=

# --- Application secrets ------------------------------------------------------
# Must be long and random; tokens signed with a guessable secret can be forged.
# openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=

# --- Frontend wiring ----------------------------------------------------------
# Exact origin of the Vercel deployment — scheme + host, no trailing slash, no path.
# Comma-separate to allow more than one. These must match exactly; preview deployments get
# fresh hostnames and will NOT be covered by the production origin.
APP_CORS_ALLOWED_ORIGINS=https://your-app.vercel.app

# Where password-reset emails point. Same origin as above plus the reset route.
APP_FRONTEND_RESET_PASSWORD_URL=https://your-app.vercel.app/reset-password

# --- reCAPTCHA ----------------------------------------------------------------
APP_RECAPTCHA_ENABLED=true
APP_RECAPTCHA_SITE_SECRET=

# --- First-boot admin ---------------------------------------------------------
# Set BOTH for the very first start against an empty database, then delete both lines and
# restart. The account is created with mustChangePassword, so this password only works once.
# Minimum 12 characters. Leaving these set does not reset an existing admin, but leaving
# credentials on disk with no reason to be there is its own problem.
# APP_BOOTSTRAP_ADMIN_EMAIL=admin@yourdomain.com
# APP_BOOTSTRAP_ADMIN_PASSWORD=
